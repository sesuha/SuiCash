# SuiCash environment variables. TESTNET ONLY.
#
# Copy this file to `.env` in the repository root and fill it in. `.env` is
# gitignored; never commit it, and never put a mainnet key or a seed phrase in it.
#
# How the files are used:
#   - The web app (Vite) reads only variables that start with VITE_, from `.env`
#     in the repository root. They end up in the public JavaScript bundle, so a
#     VITE_ variable must never hold a secret (vite.config.ts refuses to build if
#     one looks like a key).
#   - `pnpm dev` writes `.env.development.local` with the local anvil chain and
#     its contract addresses. In dev mode it overrides the testnet values below.
#   - Variables without the VITE_ prefix are read only by Node and Foundry
#     scripts (deploy, evidence, keeper) and never reach the browser.

# ---------------------------------------------------------------------------
# Web app (public, bundled)
# ---------------------------------------------------------------------------

# Chain ID. 84532 = Base Sepolia. `pnpm dev` uses 31337 (anvil) instead.
VITE_CHAIN_ID=84532

# JSON-RPC endpoint for chain reads and simulation. The public endpoint works
# for light use; a free Alchemy (or similar) Base Sepolia URL is more reliable.
VITE_RPC_URL=https://sepolia.base.org

# ERC-4337 bundler and paymaster URLs from your ZeroDev (or Pimlico) Base
# Sepolia project. Needed for Mode B session keys (Phase 3).
VITE_BUNDLER_URL=
VITE_PAYMASTER_URL=

# Circle test USDC on Base Sepolia (6 decimals). Faucet: https://faucet.circle.com
VITE_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Written by `pnpm deploy:testnet` (from contracts/deployments/84532.json)
# once the contracts exist (Phase 2).
VITE_VAULT_FACTORY_ADDRESS=
VITE_SAVINGS_POOL_ADDRESS=

# ---------------------------------------------------------------------------
# Scripts only (secret, never bundled)
# ---------------------------------------------------------------------------

# Testnet deployer key, used only by `pnpm deploy:testnet` and `pnpm evidence`.
# Generate one with `pnpm new-deployer-key` (writes it here and prints only the
# address) or `cast wallet new`. Fund it from a Base Sepolia faucet.
DEPLOYER_PRIVATE_KEY=

# Etherscan API key (the V2 multichain key also covers Basescan), used to verify
# contract source on Basescan during `pnpm deploy:testnet`.
BASESCAN_API_KEY=

# Optional overrides for the demo vault that `pnpm deploy:testnet` seeds (in USDC base
# units, 6 decimals, or seconds). Defaults are the handbook's: 500 / 1,000 / 50 / 1 hour /
# 2,000. The Circle faucet gives 20 USDC at a time, so on testnet a smaller buffer and fund
# are practical, e.g. SEED_BUFFER=5000000 (5 USDC), SEED_FUND=20000000 (20 USDC).
# SEED_PER_TX=500000000
# SEED_DAILY=1000000000
# SEED_BUFFER=50000000
# SEED_RECIPIENT_DELAY=3600
# SEED_FUND=2000000000
